{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openrig.dev/schemas/journey.v1.json",
  "title": "Journey v1 (openrig-world/status/journeys/<id>-v<version>.json)",
  "description": "The required steps a run must PASS for a label. A run record names its journey by id and version.",
  "type": "object",
  "required": ["schema", "id", "version", "kind", "title", "requiredSteps"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "openrig.journey/v1" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "version": { "type": "integer", "minimum": 1 },
    "kind": { "enum": ["team", "harness_check"] },
    "title": { "type": "string", "minLength": 1 },
    "requiredSteps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
